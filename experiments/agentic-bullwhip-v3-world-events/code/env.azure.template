# Azure OpenAI backend — copy this to .env.azure and fill in your credentials.
#
#   cp env.azure.template .env.azure
#
# Prerequisites:
#   - Azure OpenAI resource with gpt-4.1-mini and o4-mini deployments
#   - Python deps installed: pip install -r requirements.txt
#
# Get your endpoint and key from:
#   Azure Portal → your OpenAI resource → Keys and Endpoint

BACKEND=azure

# ---------------------------------------------------------------------------
# Azure credentials
# ---------------------------------------------------------------------------
# AZURE_ENDPOINT: the base URL of your Azure OpenAI resource.
# AZURE_API_KEY:  rotate at Azure Portal → Keys and Endpoint → Regenerate Key 1
#                 Never commit this file — it is listed in .gitignore.
AZURE_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_API_KEY=<your-api-key>
AZURE_API_VERSION=2025-01-01-preview

# ---------------------------------------------------------------------------
# Deployment names
# ---------------------------------------------------------------------------
# These must match the deployment names in Azure Portal exactly (case-sensitive).
# E1 uses MODEL_LIGHTWEIGHT (gpt-4.1-mini).
# E2 uses MODEL_REASONING (o4-mini).
MODEL_LIGHTWEIGHT=gpt-4.1-mini
MODEL_REASONING=o4-mini

# ---------------------------------------------------------------------------
# Token limits
# ---------------------------------------------------------------------------
# Lightweight model: 1024 is sufficient for a JSON order + one-sentence rationale.
# Reasoning model: 32768 gives o4-mini room for internal chain-of-thought tokens.
# Do not lower these — clamping tokens mid-reasoning produces malformed JSON.
MAX_TOKENS_LIGHTWEIGHT=1024
MAX_TOKENS_REASONING=32768

# ---------------------------------------------------------------------------
# Temperatures — experimental design rationale
# ---------------------------------------------------------------------------
# Temperature controls how much the model "explores" when generating a response.
#
# V3 temperature strategy (informed by V2 results):
#
#   Lightweight models (all conditions) → T=0.4
#     V2 used T=0.4 for gpt-4.1-mini on Azure across all conditions and
#     it produced the most stable lightweight results (OVAR 4.47-4.70,
#     std 0.07-0.14). Applied uniformly in V3 for consistency across
#     blind, context, and unstructured conditions.
#
#   Reasoning models → Azure forces T=1.0 (platform constraint)
#     Azure fixes o4-mini at temperature=1.0 regardless of what is set here.
#     Values below are recorded for provenance only.
#
# V2 finding — context + temperature interaction:
#   phi4:14b (local) was catastrophically unstable with context at T=0.3
#   (OVAR std=2.53 vs 0.00 blind at T=0.0). This is a local-only concern;
#   gpt-4.1-mini on Azure was stable across all conditions at T=0.4.
#
TEMP_LIGHTWEIGHT=0.4                   # blind_lightweight
TEMP_CONTEXT_LIGHTWEIGHT=0.4           # context_lightweight
TEMP_UNSTRUCTURED_LIGHTWEIGHT=0.4      # unstructured_lightweight
TEMP_REASONING=1.0                     # blind_reasoning:     Azure forces 1.0
TEMP_CONTEXT_REASONING=1.0             # context_reasoning:   Azure forces 1.0
TEMP_UNSTRUCTURED_REASONING=1.0        # unstructured_reasoning: Azure forces 1.0
