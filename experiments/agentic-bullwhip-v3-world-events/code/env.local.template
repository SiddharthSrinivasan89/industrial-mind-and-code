# Local Ollama backend — copy this to .env.local and fill in your values.
#
#   cp env.local.template .env.local
#
# Prerequisites:
#   - Ollama running:         ollama serve
#   - Models pulled:          ollama pull phi4:14b && ollama pull gpt-oss:120b
#   - Python deps installed:  pip install -r requirements.txt

BACKEND=local

# ---------------------------------------------------------------------------
# Ollama endpoint
# ---------------------------------------------------------------------------
# Default Ollama port. Change if you are running Ollama on a different host
# or port (e.g. a remote GPU server).
LOCAL_ENDPOINT=http://localhost:11434/v1

# Ollama requires a non-empty API key string but ignores its value.
# Change this only if your local server enforces real authentication.
LOCAL_API_KEY=ollama

# ---------------------------------------------------------------------------
# Model names
# ---------------------------------------------------------------------------
# These must match the tag shown by `ollama list` exactly.
# E1 uses MODEL_LIGHTWEIGHT.  E2 uses MODEL_REASONING.
# E4 uses MODEL_OSS_REASONING (can be a different local model for comparison).
MODEL_LIGHTWEIGHT=phi4:14b
MODEL_REASONING=gpt-oss:120b
MODEL_OSS_REASONING=gpt-oss:120b

# ---------------------------------------------------------------------------
# Token limits
# ---------------------------------------------------------------------------
# Lightweight model: 1024 is sufficient for a JSON order + one-sentence rationale.
# Reasoning model: 32768 gives the model room for chain-of-thought before output.
# Do not lower these — clamping tokens mid-reasoning produces malformed JSON.
MAX_TOKENS_LIGHTWEIGHT=1024
MAX_TOKENS_REASONING=32768

# ---------------------------------------------------------------------------
# Temperatures — experimental design rationale
# ---------------------------------------------------------------------------
# Temperature controls how much the model "explores" when generating a response.
#
# V3 temperature strategy (informed by V2 results):
#
#   Lightweight models (all conditions) → T=0.4
#     V2 used T=0.4 for gpt-4.1-mini on Azure and it produced the most
#     stable lightweight results (OVAR 4.47-4.70, std 0.07-0.14). Applied
#     uniformly in V3 for consistency across blind/context/unstructured.
#
#   Reasoning models:
#     blind    → T=0.0 (deterministic — isolates demand noise from model noise)
#     context  → T=0.3 (controlled exploration for context-informed strategies)
#
# V2 finding — IMPORTANT for local lightweight models:
#   phi4:14b was catastrophically unstable with context prompts at T=0.3
#   (OVAR exploded from 4.33 to 6.35, std from 0.00 to 2.53). V3 uses
#   T=0.4 uniformly for lightweight. Monitor context/unstructured runs for
#   instability — if phi4:14b diverges again, consider reducing to T=0.0.
#
# Changing these values:
#   Re-run smoke tests first and check for increased JSON parse failures
#   (attempt_number > 1 in records.parquet).
#
TEMP_LIGHTWEIGHT=0.4                   # blind_lightweight
TEMP_CONTEXT_LIGHTWEIGHT=0.4           # context_lightweight
TEMP_UNSTRUCTURED_LIGHTWEIGHT=0.4      # unstructured_lightweight
TEMP_REASONING=0.0                     # blind_reasoning:     deterministic
TEMP_CONTEXT_REASONING=0.3             # context_reasoning:   context-informed exploration
TEMP_UNSTRUCTURED_REASONING=0.3        # unstructured_reasoning: context-informed exploration
