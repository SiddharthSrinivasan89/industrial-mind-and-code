# Azure OpenAI backend — copy this to .env.azure and fill in your credentials.
#
#   cp env.azure.template .env.azure
#
# Prerequisites:
#   - Azure OpenAI resource with gpt-4.1-mini and o4-mini deployments
#   - Python deps installed: pip install -r requirements.txt
#
# Get your endpoint and key from:
#   Azure Portal → your OpenAI resource → Keys and Endpoint

BACKEND=azure

# ---------------------------------------------------------------------------
# Azure credentials
# ---------------------------------------------------------------------------
# AZURE_ENDPOINT: the base URL of your Azure OpenAI resource.
# AZURE_API_KEY:  rotate at Azure Portal → Keys and Endpoint → Regenerate Key 1
#                 Never commit this file — it is listed in .gitignore.
AZURE_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_API_KEY=<your-api-key>
AZURE_API_VERSION=2025-01-01-preview

# ---------------------------------------------------------------------------
# Deployment names
# ---------------------------------------------------------------------------
# These must match the deployment names in Azure Portal exactly (case-sensitive).
# E1 uses MODEL_LIGHTWEIGHT (gpt-4.1-mini).
# E2 uses MODEL_REASONING (o4-mini).
MODEL_LIGHTWEIGHT=gpt-4.1-mini
MODEL_REASONING=o4-mini

# ---------------------------------------------------------------------------
# Token limits
# ---------------------------------------------------------------------------
# Lightweight model: 1024 is sufficient for a JSON order + one-sentence rationale.
# Reasoning model: 32768 gives o4-mini room for internal chain-of-thought tokens.
# Do not lower these — clamping tokens mid-reasoning produces malformed JSON.
MAX_TOKENS_LIGHTWEIGHT=1024
MAX_TOKENS_REASONING=32768

# ---------------------------------------------------------------------------
# Temperatures — experimental design rationale
# ---------------------------------------------------------------------------
# Temperature controls how much the model "explores" when generating a response.
#
# Design principle:
#   blind conditions  → temperature=0.0 (deterministic)
#     The agent has no contextual signal to reason about — only raw numbers.
#     Determinism eliminates model sampling noise from OVAR measurements,
#     so any variance in orders is attributable to demand variance alone.
#
#   context conditions → temperature=0.3 (controlled exploration)
#     The agent receives calendar month + company persona. Temperature > 0
#     allows the model to explore context-informed ordering strategies
#     (e.g. smoothing ahead of a known demand peak like Diwali).
#     If we keep temp=0 here, the model is locked to its highest-probability
#     token and cannot leverage the context signal creatively — which would
#     defeat the purpose of the blind vs context comparison.
#
# IMPORTANT — Azure reasoning model override:
#   Azure fixes o4-mini at temperature=1.0 regardless of what is set here.
#   TEMP_REASONING and TEMP_CONTEXT_REASONING below have no effect on Azure
#   reasoning calls. They are included so provenance.json records the intended
#   design config, making it clear this is a platform constraint, not a choice.
#
TEMP_LIGHTWEIGHT=0.4          # blind_lightweight:   analytical
TEMP_CONTEXT_LIGHTWEIGHT=0.4  # context_lightweight: analytical
TEMP_REASONING=1.0            # blind_reasoning:     Azure forces 1.0 (no effect to change)
TEMP_CONTEXT_REASONING=1.0    # context_reasoning:   Azure forces 1.0 (no effect to change)
