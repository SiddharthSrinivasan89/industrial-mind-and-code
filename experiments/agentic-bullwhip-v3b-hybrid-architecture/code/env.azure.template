# V3b Hybrid Architecture — Azure OpenAI backend
# Copy to .env.azure and fill in your Azure credentials.

BACKEND=azure
AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_API_KEY=<your-api-key>
AZURE_API_VERSION=2025-01-01-preview

# Lightweight model — gpt-4.1 (used for all V3b hybrid azure conditions)
MODEL_LIGHTWEIGHT=gpt-4.1-mini

# Reasoning model — o4-mini (not used in V3b hybrid conditions; here for future reasoning-tier conditions)
MODEL_REASONING=o4-mini

# Max tokens — 2048 gives ample budget for JSON output on both gpt-4.1 and o4-mini.
MAX_TOKENS_LIGHTWEIGHT=2048
MAX_TOKENS_REASONING=2048

# Temperature for all hybrid conditions.
# Note: azure_backend.py does not send temperature in API calls (cross-model compatibility).
# gpt-4.1 uses its API default; o4-mini does not accept custom temperature.
TEMP_HYBRID=0.3
