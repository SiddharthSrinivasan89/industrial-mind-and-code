# V3b Hybrid Architecture — Azure OpenAI backend
# Copy to .env.azure and fill in your Azure credentials.

BACKEND=azure
AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_API_KEY=<your-api-key>
AZURE_API_VERSION=2025-01-01-preview

# Deployment name for the lightweight model (comparison to local gpt-oss:120b)
MODEL_LIGHTWEIGHT=gpt-4.1-mini

# Max tokens — hybrid output is short; 256 is sufficient headroom.
MAX_TOKENS_LIGHTWEIGHT=256

# Temperature for all hybrid conditions.
# Azure gpt-4.1-mini honours temperature settings.
TEMP_HYBRID=0.3
