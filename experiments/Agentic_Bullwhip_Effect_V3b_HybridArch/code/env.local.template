# V3b Hybrid Architecture — Local backend (llama-server / vLLM / Ollama)
# Copy to .env.local and fill in your endpoint details.

BACKEND=local
LOCAL_ENDPOINT=http://localhost:11434/v1
LOCAL_API_KEY=ollama

# Primary experiment model (gpt-oss:120b via llama-server or vLLM)
MODEL_LOCAL=gpt-oss:120b

# MODEL_LIGHTWEIGHT is used for the "lightweight" model_tier.
# For local-only runs, point both to the same model.
MODEL_LIGHTWEIGHT=gpt-oss:120b

# Max tokens — hybrid output is short (multiplier + one sentence ≈ 60 tokens).
# 256 is generous headroom; reduce if latency is a concern.
MAX_TOKENS_LIGHTWEIGHT=256
MAX_TOKENS_REASONING=256

# Temperature for all hybrid conditions (blind, context, stateful).
# 0.3 allows multiplier variation across 20 runs without erratic outputs.
# Do not set to 0.0 — that collapses all 20 runs to identical multipliers
# and eliminates the statistical power of the run ensemble.
TEMP_HYBRID=0.3

# Think flag style — controls thinking/extended reasoning in models that support it.
# sarvam-105b uses "enable_thinking=false", most others use "think=false".
# Set to "none" to omit the flag entirely (standard models like gpt-oss:120b).
THINK_FLAG_STYLE=none

# DRY_RUN=1: skip all LLM calls, return multiplier=1.0 (neutral hybrid baseline).
# Use this to validate the simulation + metrics pipeline without any API cost.
# Uncomment to enable:
# DRY_RUN=1
